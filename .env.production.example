# Copy this file to .env.production (it is git-ignored, never commit it) and fill in your TiDB Cloud values.
# It is used ONLY from your own computer, to run migrations, imports and checks against the TiDB database:
#   npm run db:migrate:prod        create the tables
#   npm run import:uci:prod        load the ServiceNow demo data
#   npm run import:osha:prod       load the OSHA demo data
#   npm run db:app-user:prod       create the least-privilege user the live app uses
#   npm run db:verify:prod         check the schema rules
# The live web service on Render gets its own values in its Environment tab, not from this file.

# --- the ADMIN user: runs migrations and imports (TiDB shows it as something like 4ZpAbCd.root) ---
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=your_admin_password
DB_NAME=aravalli
# TLS with the trusted authorities that come with Node: no certificate file needed
DB_SSL=true

# --- the APP user to create: what the live app connects as. Same prefix as the admin user, a new name, a long password ---
APP_DB_USER=xxxxxxxx.aravalli_app
APP_DB_PASSWORD=choose_a_long_random_password_here
