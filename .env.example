# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.

# ---- Database (MySQL 8.0.16 or newer) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# Use a name that contains "dev" or "test": `npm run db:reset` refuses to drop anything else.
DB_NAME=aravalli_dev

# ---- API server ----
# Port for the API (the web app dev server forwards /api to it).
# API_PORT=3001
# DEV ONLY until login exists: the organisation used when a request names none (default: the lowest id).
# DEV_ORGANISATION_ID=1
# The separate database the API and browser tests build from scratch. Must look disposable (contain "test").
# TEST_DB_NAME=aravalli_test

# Optional: full path to the mysql command-line client if it is not on your PATH.
# Example on Windows: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# MYSQL_BIN=

# ---- Only needed if you run MySQL through docker-compose.yml ----
# Password for the container's root user.
MYSQL_ROOT_PASSWORD=change-me-root
