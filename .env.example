# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.

# ---- Database (MySQL 8.0.16 or newer) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# Use a name that contains "dev" or "test": `npm run db:reset` refuses to drop anything else.
DB_NAME=aravalli_dev

# ---- API server ----
# Port for the API (the web app dev server forwards /api to it).
# API_PORT=3001
# The separate database the API and browser tests build from scratch. Must look disposable (contain "test").
# TEST_DB_NAME=aravalli_test

# ---- Sign-in ----
# Signs the short-lived access tokens. REQUIRED in production (32+ characters; generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# In development, if unset, a random one is made on every start (you are simply signed in again through the refresh cookie).
# JWT_SECRET=
# ACCESS_TOKEN_SECONDS=900
# REFRESH_TOKEN_DAYS=30
# The refresh cookie is Secure by default (browsers accept that on http://localhost). Set false only for odd local setups.
# COOKIE_SECURE=true
# Demo login buttons for the two demonstration organisations. NEVER on a real deployment.
DEMO_LOGINS=true
# Rate limits on login and sign-up (attempts per window, window in seconds).
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_SIGNUP=10
# RATE_LIMIT_WINDOW_SECONDS=900

# ---- Production (Render + TiDB Cloud): see docs/DEPLOY-RENDER.md ----
# NODE_ENV=production makes the API also serve the built web app (apps/web/dist).
# Hosting services such as Render give the app its port in PORT; API_PORT is the setting for local use.
# DB_SSL=true connects over TLS and checks the server's certificate against the authorities that ship with Node (TiDB Cloud).
# Instead you can give a private authority: DB_SSL_CA (the certificate text) or DB_SSL_CA_FILE (the path of a ca.pem). Leave all out for local MySQL.
# DB_SSL=true
# The migrations, imports and checks you run from your laptop against TiDB read a separate git-ignored file, .env.production (see .env.production.example).

# Optional: full path to the mysql command-line client if it is not on your PATH.
# Example on Windows: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# MYSQL_BIN=

# ---- Only needed if you run MySQL through docker-compose.yml ----
# Password for the container's root user.
MYSQL_ROOT_PASSWORD=change-me-root
