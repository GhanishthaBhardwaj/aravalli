{
  "name": "@aravalli/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API server (filled in during Phase 2). For now it owns the database: migrations, the migration runner, the sample seed and the verification script.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed-sql": "tsx scripts/generate-seed-sql.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/migrate.ts seed",
    "db:reset": "tsx src/db/migrate.ts reset",
    "db:verify": "tsx src/db/verify.ts"
  },
  "dependencies": {
    "@aravalli/shared": "*"
  }
}
