{
  "name": "@aravalli/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API server (filled in during Phase 2). For now it owns the database: migrations, the migration runner, the sample seed and the verification script.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed-sql": "tsx scripts/generate-seed-sql.ts",
    "data:download": "tsx scripts/download-data.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/migrate.ts seed",
    "db:reset": "tsx src/db/migrate.ts reset",
    "db:verify": "tsx src/db/verify.ts"
  },
  "dependencies": {
    "@aravalli/shared": "*",
    "express": "^4.22.3",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1"
  }
}
